{
  "name": "theozebua/oze-framework-core",
  "description": "Just a simple mvc framework for beginners.",
  "keywords": [
    "teecoder",
    "oze",
    "mvc",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "vlucas/phpdotenv": "^5.5",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "nunomaduro/collision": "^6.0",
    "laravel/pint": "^1.16"
  },
  "autoload": {
    "psr-4": {
      "OzeFramework\\": "src/OzeFramework/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OzeFramework\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format": "./vendor/bin/pint",
    "lint": "./vendor/bin/pint --test",
    "test": "./vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
